<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- CefGlue's targets reach this project transitively; it needs none of their native files either. -->
    <CefGlueTargetPlatform>none</CefGlueTargetPlatform>
  </PropertyGroup>
  <ItemGroup>
    <!-- The checks never start Chromium: building the launcher without CEF's native files keeps them from depending
         on how each OS's CEF package lays those files out (it broke the macOS check build). -->
    <ProjectReference Include="../ClientLab.Launcher/ClientLab.Launcher.csproj" AdditionalProperties="CefGlueTargetPlatform=none" />
  </ItemGroup>
</Project>

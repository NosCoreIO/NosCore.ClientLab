<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NosCore.ClientLab.Launcher.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window"><Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif" /><Setter Property="Background" Value="#10131C" /><Setter Property="Foreground" Value="#EDF1FA" /></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="9" /><Setter Property="Padding" Value="17,11" /><Setter Property="Cursor" Value="Hand" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#B9F074" /><Setter Property="Foreground" Value="#152213" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="28,15" /></Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#CEF6A0" /><Setter Property="Foreground" Value="#152213" /></Style>
    <Style Selector="Button.nav"><Setter Property="Background" Value="Transparent" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Foreground" Value="#A4ABBD" /><Setter Property="Padding" Value="18,13" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="Button.nav.active"><Setter Property="Background" Value="#242B36" /><Setter Property="Foreground" Value="#D9F4B7" /></Style>
    <Style Selector="TextBox"><Setter Property="Background" Value="#141924" /><Setter Property="BorderBrush" Value="#323A4A" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="12,11" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#939CAF" /></Style>
    <Style Selector="TextBlock.eyebrow"><Setter Property="Foreground" Value="#8B97AA" /><Setter Property="FontSize" Value="11" /><Setter Property="LetterSpacing" Value="2" /></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="#191E2A" /><Setter Property="CornerRadius" Value="14" /><Setter Property="BorderBrush" Value="#2A3242" /><Setter Property="BorderThickness" Value="1" /></Style>
  </Application.Styles>
</Application>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>ClientLab</AssemblyName>
    <ApplicationIcon>Assets/noscore.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>NosCore.ClientLab.Launcher</RootNamespace>
    <Version>0.1.0</Version>
    <PublishTrimmed>false</PublishTrimmed>
    <CefArchitecture Condition="'$(CefArchitecture)' == ''">x64</CefArchitecture>
    <!-- Without a runtime identifier CefGlue falls back to osx-arm64 on every Mac, whose files the x64 package does
         not contain, so building (for example the checks) fails. Follow the package that is actually referenced. -->
    <CefGlueTargetPlatform Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">osx-$(CefArchitecture)</CefGlueTargetPlatform>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="CefGlue.Avalonia" Version="120.6099.215" Condition="'$(CefArchitecture)' == 'x64'" />
    <PackageReference Include="CefGlue.Avalonia.ARM64" Version="120.6099.215" Condition="'$(CefArchitecture)' == 'arm64'" />
    <PackageReference Include="Wasmtime" Version="50.0.1" />
  </ItemGroup>
  <!-- publish.ps1 ships Chromium as its own release download (the launcher fetches it on first start, BrowserRuntime).
       This lists every published file that comes from the CEF packages, by where it was copied from (the ARM64 build
       uses CefGlue.Common.ARM64, so the package folder is matched by prefix). -->
  <Target Name="ListBrowserFiles" AfterTargets="Publish" Condition="'$(BrowserFileList)' != ''">
    <ItemGroup>
      <_ClientLabBrowserFile Include="@(ResolvedFileToPublish)"
        Condition="$([System.String]::new('%(FullPath)').Replace('\','/').ToLowerInvariant().Contains('/cef.redist.')) or
                   $([System.String]::new('%(FullPath)').Replace('\','/').ToLowerInvariant().Contains('/chromiumembeddedframework.runtime')) or
                   ($([System.String]::new('%(FullPath)').Replace('\','/').ToLowerInvariant().Contains('/cefglue.common')) and
                    $([System.String]::new('%(FullPath)').Replace('\','/').ToLowerInvariant().Contains('/bin/')))" />
    </ItemGroup>
    <WriteLinesToFile File="$(BrowserFileList)" Lines="@(_ClientLabBrowserFile->'%(RelativePath)'->Distinct())" Overwrite="true" />
  </Target>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <EmbeddedResource Include="Assets/gameforge-verification.js" LogicalName="GameforgeVerification.js" />
    <EmbeddedResource Include="Assets/browser-launcher.html" LogicalName="BrowserLauncher.html" />
    <EmbeddedResource Include="Assets/packet-logger.html" LogicalName="PacketLogger.html" />
    <EmbeddedResource Include="Assets/noscore.png" LogicalName="LauncherLogo.png" />
    <ProjectReference Include="../../recomp/dotnet/ClientLab.Recompiler/ClientLab.Recompiler.csproj" />
    <ProjectReference Include="../ClientLab.Plugins/ClientLab.Plugins.csproj" />
    <Compile Include="../Shared/LauncherUpdate.cs" Link="Shared/LauncherUpdate.cs" />
    <EmbeddedResource Include="../../recomp/port/*.c;../../recomp/port/*.h;../../recomp/port/*.inc" LogicalName="Source/recomp/port/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../recomp/runtime/*.c;../../recomp/runtime/*.h" LogicalName="Source/recomp/runtime/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../recomp/web/index.html;../../recomp/web/worker.js;../../recomp/web/gl.js" LogicalName="Source/recomp/web/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../symbols/**/*.txt" LogicalName="Source/symbols/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The runtime module prebuilt by the release workflow (the build-host command); absent in local builds, which compile it. -->
    <EmbeddedResource Include="Prebuilt/host/*" LogicalName="Prebuilt/host/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
